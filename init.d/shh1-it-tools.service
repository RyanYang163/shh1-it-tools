[Unit]
Description=IT-Tools (TOS 7)
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=shh1ittools
Group=shh1ittools
WorkingDirectory=/usr/local/shh1-it-tools
ExecStart=/usr/local/shh1-it-tools/bin/shh1-it-tools
EnvironmentFile=-/usr/local/shh1-it-tools/shh1-it-tools.env
TimeoutStartSec=30
TimeoutStopSec=10

# ---- 安全加固（指引 13.8 必需项，缺一不可）----
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native

# ---- 可写路径（ProtectSystem=strict 下必须显式放开）----
ReadWritePaths=/usr/local/shh1-it-tools /var/lib/shh1-it-tools /var/log/shh1-it-tools

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
